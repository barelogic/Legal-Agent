# Copy to .env and fill in. Provider/model are read at runtime (see generation/config.py).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=tfidf-local
# tfidf-local = lexical only (offline default). For dense retrieval set e.g.
# EMBED_MODEL=BAAI/bge-m3 (requires sentence-transformers + chromadb).
RERANKER_MODEL=BAAI/bge-reranker-base
CHROMA_DIR=data/chroma
# lexical (default) or hybrid. Hybrid uses BM25 (+ dense/rerank when installed)
# and falls back to lexical automatically. POST /answer also uses hybrid when
# doc_ids are supplied.
RETRIEVAL_BACKEND=lexical
TOP_K=4
# Entailment judge model (verify/judge.py). When set, the judge uses it;
# otherwise it picks a model unlike the generator's. Skipped under mock.
LLM_JUDGE_MODEL=
# Verifier hardening flags (verify/flags.py). All default ON;
# set to 0 to disable individually.
VERIFY_TEXT=1
VERIFY_ENTAILMENT=1
VERIFY_CITATION_GATE=1
VERIFY_REGENERATE=1
# Relevance gates (retrieval). P2 sweeps these on non-holdout data;
# defaults below are the allowed-split analysis starting points.
# MIN_COVERAGE: fraction of distinct query content tokens a chunk must
# contain (lexical + hybrid BM25 legs; section-label asks bypass).
MIN_COVERAGE=0.32
# RERANK_MIN_SCORE: cross-encoder cutoff; chunks below are dropped, empty
# means refuse. Also the dense leg's only gate (dense is never token-gated).
# Default 0.0 is the logit sign boundary, pending P2's sweep.
RERANK_MIN_SCORE=0.0
