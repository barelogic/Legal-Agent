# Copy to .env and fill in. Provider/model are read at runtime (see generation/config.py).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=tfidf-local
# tfidf-local = lexical only (offline default). For dense retrieval set e.g.
# EMBED_MODEL=BAAI/bge-m3 (requires sentence-transformers + chromadb).
RERANKER_MODEL=BAAI/bge-reranker-base
CHROMA_DIR=data/chroma
# lexical (default) or hybrid. Hybrid uses BM25 (+ dense/rerank when installed)
# and falls back to lexical automatically. POST /answer also uses hybrid when
# doc_ids are supplied.
RETRIEVAL_BACKEND=lexical
TOP_K=4
