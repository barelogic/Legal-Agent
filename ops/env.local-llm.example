# Local-LLM env pins (copy to `.env`; NEVER commit `.env`).
# Kept in ops/ (not `.env.example`) because eval/tests/test_prod_gemini.py
# forbids committed loopback endpoints in `.env.example`.
LLM_PROVIDER=openai_compatible
LLM_MODEL=llama3.1:8b
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
# Embeddings: local sentence-transformers (pre-downloaded; see ops/pull_models.sh).
# tfidf-local = lexical only (offline default). Dense needs this exact id.
EMBED_MODEL=BAAI/bge-m3
# Reranker is OFF on the 8GB laptop (VRAM + latency); empty disables rerank.
RERANKER_MODEL=
CHROMA_DIR=data/chroma
# Embedding device (new core env, 25de873): cpu at the venue — measured CUDA
# OOM on the shared 8GB GPU during ST weight loads (see docs/local_llm.md).
EMBED_DEVICE=cpu
RETRIEVAL_BACKEND=lexical
TOP_K=4
# LLM_TIMEOUT is PROPOSED (pending user1, see user4.md Step 8); not yet read
# by generation/llm.py. Do not uncomment until the patch lands.
# LLM_TIMEOUT=180
# Independent judge: deterministic fallback offline (no second local model).
JUDGE_MODEL=
LLM_JUDGE_MODEL=
VERIFY_TEXT=1
VERIFY_ENTAILMENT=1
VERIFY_CITATION_GATE=1
VERIFY_REGENERATE=1
